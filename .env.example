# Twilio — from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 outbound number, e.g. +15551234567
TWILIO_PHONE_NUMBER=
# Optional alternative to TWILIO_PHONE_NUMBER (recommended for Messaging Services)
# Example: MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=
# Outbound cap to avoid Twilio Trial segment limits (default 160; consider 120 for safety)
TWILIO_MAX_OUTBOUND_CHARS=160
# Full public URL Twilio POSTs to (must match webhook config exactly, including path)
# Example: https://your-domain.com/webhook/sms
TWILIO_WEBHOOK_URL=

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# OpenAI-compatible base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Default model
DEEPSEEK_MODEL=deepseek-chat

# Admin API key for /admin/stats (send as x-admin-key). Use a long random string.
ADMIN_API_KEY=
# Full URL to your deployed stats endpoint
# Example: https://try.apricity.chat/admin/stats
ADMIN_STATS_URL=

# Crypto (required)
# In AWS: set KMS_KEY_ID to your KMS key ARN/ID (and ensure the EB instance role can kms:Encrypt/kms:Decrypt)
AWS_REGION=us-east-1
KMS_KEY_ID=
# Local dev fallback: base64 for 32 random bytes (AES-256-GCM). Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_ENCRYPTION_KEY=

# PostgreSQL connection string (docker-compose default shown)
DATABASE_URL=postgresql://iris:iris@localhost:5432/iris_sms?schema=public

PORT=3000
NODE_ENV=development

# Rate limit: per phone number (hashed key), sliding/window behavior via in-memory store
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=20
