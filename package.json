{
  "name": "sms-iris-chatbot",
  "version": "1.0.0",
  "description": "SMS AI companion via Twilio + Claude",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "admin:stats": "tsx src/tools/admin-stats.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.864.0",
    "@prisma/client": "^6.7.0",
    "dotenv": "^16.6.1",
    "prisma": "^6.7.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.6.0",
    "twilio": "^5.6.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "private": true,
  "type": "module"
}
